{
  "name": "c/c++/vcpkg container",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteEnv": {
    "VCPKG_ROOT": "/opt/vcpkg",
    "VCPKG_FORCE_SYSTEM_BINARIES": 1,
    "CMAKE_C_COMPILER": "/etc/alternatives/clang",
    "CMAKE_CXX_COMPILER": "/etc/alternatives/clang++"
  },
  "remoteUser": "root"
}
